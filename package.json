{
	"name": "localcloud",
	"version": "0.0.1",
	"description": "",
	"private": true,
	"license": "GPL-3.0-or-later",
	"author": "James Prevett",
	"type": "module",
	"main": "index.js",
	"scripts": {
		"serve": "axium serve",
		"clean": "rm -rf build",
		"build": "axium build",
		"dev": "axium dev -l -w routes/*"
	},
	"dependencies": {
		"@axium/calendar": "^0.5.5",
		"@axium/client": "^0.39.1",
		"@axium/contacts": "^0.3.5",
		"@axium/core": "^0.41.1",
		"@axium/email": "^0.1.6",
		"@axium/kino": "^0.2.4",
		"@axium/notes": "^0.4.6",
		"@axium/server": "^0.57.0",
		"@axium/storage": "^0.32.6",
		"@axium/sysadmin": "^0.3.3",
		"@axium/tasks": "^0.5.9",
		"semver": "^7.7.3",
		"svelte": "^5.57.1",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.4.0",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^4.1.0",
		"typescript": "^6.0.2"
	},
	"prettier": {
		"plugins": [
			"prettier-plugin-svelte"
		],
		"singleQuote": true,
		"useTabs": true,
		"trailingComma": "es5",
		"tabWidth": 4,
		"printWidth": 140,
		"arrowParens": "avoid"
	},
	"axium": {
		"server": {}
	},
	"allowScripts": {
		"file:../axium/packages/server": true,
		"file:../axium/packages/core": true,
		"@axium/core": true,
		"@axium/server": true,
		"sharp": true,
		"esbuild": true
	}
